  "findings": [
    {
      "title": "Privacy costs 3\u20138% of forecast accuracy",
      "detail": "Federated training reaches 15.10/19.38/20.69 RMSE at 1/3/6h against a centralised ST-GNN ceiling of 14.62/18.10/19.21 \u2014 the price of never pooling raw data.",
      "caveat": "Measured on one test window; not bootstrapped.",
      "tone": "good"
    },
    {
      "title": "Neighbours detect faults no local model can",
      "detail": "Stuck-at recall is 0.000 for every rung that looks only at a station's own history \u2014 including the centralised model with full raw access \u2014 and 0.134\u20130.220 for the proposed model, which uses cross-station agreement from compressed embeddings only.",
      "caveat": "Real under time resampling; not significant when stations are also resampled, at n=7.",
      "tone": "good"
    },
    {
      "title": "Accuracy is the wrong metric here",
      "detail": "At a 2.8% fault rate a classifier answering \u201cnever faulty\u201d scores 0.977 accuracy \u2014 higher than this system's 0.976. Recall, precision and AUC-PR are what mean anything.",
      "caveat": null,
      "tone": "warn"
    },
    {
      "title": "Drift remains unsolved",
      "detail": "Slow calibration drift is never detected at the alert operating point. Its per-hour deviation is smaller than normal variation, so no threshold reaches it.",
      "caveat": "Real sensor drift is ~30\u00d7 slower than the injected version, so this is if anything optimistic.",
      "tone": "bad"
    },
    {
      "title": "EEA's fault labels contain no reading",
      "detail": "All 27,783 Validity-flagged rows carry the \u2212999 no-data sentinel, so the readings this project exists to adjudicate are absent rather than wrong. Evaluation uses rate-matched synthetic faults instead.",
      "caveat": "Injection rate and episode durations are taken from the real data; only the corrupted value is synthesised.",
      "tone": "warn"
    }
  ]
}